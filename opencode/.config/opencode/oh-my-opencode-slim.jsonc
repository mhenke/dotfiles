        {"id": "github-copilot/claude-opus-5.5", "variant": "high"},
        {"id": "openai/gpt-6-astra", "variant": "high"},
        {"id": "commandcode/z-ai/glm-5.3-flash", "variant": "high"},
        {"id": "opencode/gpt-6-luna", "variant": "high"}
      ],
      "description": "Escalation tier for the decisions cheaper agents could not settle"
    }
  },
