  "council": {
    "presets": {
      "balanced": {
        "alpha": {
          "model": [
            "opencode/muse-spark-1.3-contributor-free",
            "omniroute/oracle"
          ],
          "variant": "high",
          "fallback_models": []
        },
        "beta": {
          "model": [
            "opencode/nemotron-3-ultra-free",
            "omniroute/skeptic"
          ],
          "variant": "high",
          "fallback_models": []
        },
        "gamma": {
          "model": [
            "opencode/mimo-v2.6-flash-free",
            "omniroute/observer"
          ],
          "fallback_models": []
        }
      },
      "hybrid-glm-kimi": {
        "alpha": {
          "model": [
            "zai-coding-plan/glm-5.3",
            "nvidia/z-ai/glm-5.3"
          ],
          "variant": "high"
        },
        "beta": {
          "model": [
            "kimi-code-plan-global/k3",
            "nvidia/moonshotai/kimi-k3"
          ]
        }
      }
    },
    "default_preset": "hybrid-glm-kimi",
    "councillor_execution_mode": "parallel"
  },
  "websearch": {
    "provider": "exa"
  },
  "todoContinuation": {
    "maxContinuations": 5,
    "cooldownMs": 3000,
    "autoEnable": true,
    "autoEnableThreshold": 3
  }
}
