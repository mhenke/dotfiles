{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "compactSidebar": true,
  "preset": "balanced",
  "disabled_agents": [],
  "image_routing": "auto",
  "autoUpdate": true,
  "setDefaultAgent": true,
  "multiplexer": {
    "type": "herdr",
    "layout": "main-vertical"
  },
  "scoringEngineVersion": "v2",
  "presets": {
    "balanced": {
      "orchestrator": {
        "model": "omniroute/orchestrator",
        "temperature": 0.4,
        "skills": [
          "*"
        ],
        "mcps": [
          " ",
          "!context7"
        ]
      },
      "oracle": {
        "model": "omniroute/oracle",
        "temperature": 0.4,
        "variant": "high",
        "skills": [
          "simplify"
        ],
        "mcps": []
      },
      "designer": {
        "model": "omniroute/designer",
        "temperature": 0.3,
        "variant": "xhigh",
        "skills": [],
        "mcps": []
      },
      "librarian": {
        "model": "omniroute/librarian",
        "temperature": 0.2,
        "skills": [],
        "mcps": [
          "websearch",
          "context7",
          "gh_grep"
        ]
      },
      "explorer": {
        "model": "omniroute/explorer",
        "temperature": 0.2,
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "omniroute/fixer",
        "temperature": 0.2,
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": "omniroute/observer",
        "temperature": 0.2,
        "skills": [],
        "mcps": []
      },
      "council": {
        "model": "omniroute/orchestrator"
      },
      "skeptic": {
        "model": "omniroute/skeptic",
        "variant": "max"
      }
    },
    "nvidia-free": {
      "orchestrator": {
        "model": [
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
          "nvidia/stepfun-ai/laguna-xs-2.1",
          "nvidia/moonshotai/kimi-k3"
        ],
        "temperature": 0.4,
        "skills": [
          "*"
        ],
        "mcps": [
          " ",
          "!context7"
        ]
      },
      "oracle": {
        "model": [
          "deepseek-ai/deepseek-v4-flash-0731",
          "nvidia/moonshotai/kimi-k3",
          "nvidia/mistralai/mistral-nemotron"
        ],
        "temperature": 0.4,
        "variant": "high",
        "skills": [
          "simplify"
        ],
        "mcps": []
      },
      "explorer": {
        "model": [
          "nvidia/nvidia/nvidia-nemotron-nano-9b-v2"
        ],
        "temperature": 0.2,
        "skills": [],
        "mcps": []
      },
      "librarian": {
        "model": [
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "nvidia/moonshotai/kimi-k3"
        ],
        "temperature": 0.2,
        "skills": [],
        "mcps": [
          "websearch",
          "context7",
          "gh_grep"
        ]
      },
      "designer": {
        "model": [
          "nvidia/moonshotai/kimi-k3",
          "nvidia/mistralai/mistral-nemotron",
          "deepseek-ai/deepseek-v4-flash-0731"
        ],
        "temperature": 0.3,
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": [
          "nvidia/nemotron-3.5-lightning-30b-a3b"
        ],
        "temperature": 0.2,
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": [
          "nvidia/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
          "nvidia/moonshotai/kimi-k3"
        ],
        "temperature": 0.2,
        "skills": [],
        "mcps": []
      },
      "council": {
        "model": [
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
          "nvidia/stepfun-ai/laguna-xs-2.1",
          "nvidia/moonshotai/kimi-k3"
        ]
      },
      "skeptic": {
        "model": [
          "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
          "nvidia/mistralai/mistral-medium-3.5-128b",
          "nvidia/nvidia/nvidia-nemotron-nano-9b-v2"
        ],
        "variant": "max"
      }
    },
    "opencode-zen-free": {
      "_deprecated": "2026-09-17 — all opencode/* free ids are gate-locked to the OpenCode CLI at the server (FreeTierError 403). This preset is kept commented out as a historical reference. Use the 'balanced' preset with omniroute/<role> combo chains instead.",
      "orchestrator": {
        "model": ["opencode/nemotron-3-ultra-free", "opencode/big-pickle", "opencode/muse-spark-1.2-contributor-free"],
        "temperature": 0.4
      },
      "explorer": { "model": "opencode/mimo-v2.5-free", "temperature": 0.2 },
      "librarian": { "model": "opencode/mimo-v2.5-free", "temperature": 0.2 },
      "designer":  { "model": "opencode/mimo-v2.5-free", "temperature": 0.3 },
      "fixer":     { "model": "opencode/mimo-v2.5-free", "temperature": 0.2 },
      "observer":  { "model": "opencode/mimo-v2.5-free", "temperature": 0.2 },
      "council":   { "model": "opencode/hy3-free" },
      "skeptic":   { "model": ["opencode/muse-spark-1.2-contributor-free", "opencode/nemotron-3-ultra-free"] }
    }
  },
  "council": {
    "presets": {
      "balanced": {
        "alpha": {
          "model": "omniroute/oracle",
          "variant": "high",
          "fallback_models": []
        },
        "beta": {
          "model": "omniroute/skeptic",
          "variant": "high",
          "fallback_models": []
        },
        "gamma": {
          "model": "omniroute/observer",
          "fallback_models": []
        }
      }
    },
    "default_preset": "balanced",
    "councillor_execution_mode": "parallel"
  },
  "websearch": {
    "provider": "exa"
  },
  "todoContinuation": {
    "maxContinuations": 5,
    "cooldownMs": 3000,
    "autoEnable": true,
    "autoEnableThreshold": 3
  }
}
